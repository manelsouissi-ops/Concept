# PostgreSQL connection string used by the Appels d'offres repository,
# processing jobs, documents, and audit logs. Required.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Secret used to derive opaque session hashes for authentication cookies.
# Required for real login/logout and protected pages/APIs.
AUTH_SECRET=

# Optional session TTL in seconds for the HTTP-only authentication cookie.
# Defaults to 43200 (12 hours).
AUTH_SESSION_TTL_SECONDS=43200

# Local development passwords for the seeded users in public.app_users.
# Bob Durand (ADMIN) uses CONCEPT_DEV_ADMIN_PASSWORD.
# Other seeded users use CONCEPT_DEV_USER_PASSWORD.
CONCEPT_DEV_ADMIN_PASSWORD=
CONCEPT_DEV_USER_PASSWORD=

# Development-only user switcher. Keep false outside explicit local testing.
CONCEPT_ENABLE_DEV_USER_SWITCHER=false

# Canonical n8n launch webhook called by POST /api/appels-offres/[code]/analyse
# and the compatibility route POST /api/generate. Required.
N8N_WEBHOOK_URL=https://n8n.example.com/webhook/launch
# The split pipeline is required for authoritative local Fiche generation.
CDC_WORKFLOW_MODE=split
N8N_DOCUMENT_PROCESSING_WEBHOOK_URL=https://n8n.example.com/webhook/concept-document-processing
N8N_CDC_EXTRACTION_WEBHOOK_URL=https://n8n.example.com/webhook/concept-cdc-extraction

# Bearer token the platform sends when launching a canonical analysis request
# to n8n. Must match the token the n8n workflow validates on launch. Required.
N8N_WEBHOOK_TOKEN=replace-with-launch-token

# Bearer token n8n must send back on the canonical callback
# (POST /api/fiche/callbacks/n8n). Required.
PLATFORM_CALLBACK_TOKEN=replace-with-callback-bearer-token

# Shared HMAC secret used to compute/verify X-Callback-Signature on the
# canonical n8n callback route. Required.
N8N_CALLBACK_SECRET=replace-with-hmac-secret

# Public base URL the platform uses to build BOTH callback URLs shared with n8n:
# - <base>/api/fiche/callbacks/n8n (canonical CDC/Fiche callback)
# - <base>/api/fci/callbacks/n8n   (FCI module callback, see FCI_N8N_WEBHOOK_URL below)
# Required.
#
# LOCAL DEV: this MUST match the port `npm run dev` actually binds to, or n8n's
# callback will silently go nowhere and the tender will spin in "En cours
# d'analyse" forever (no callback ever arrives to flip its status). `next dev`
# defaults to port 3000 and only auto-hops to another port if 3000 is already
# taken by something else - if that happens, either free port 3000 or update
# this value (and PLATFORM_CALLBACK_TOKEN/N8N_CALLBACK_SECRET stay the same,
# only the host:port changes) to match whatever port the dev server printed on
# startup. There is no code-level fallback/default for this value on purpose;
# it must always reflect where the app is actually listening.
PLATFORM_PUBLIC_BASE_URL=https://platform.example.com

# Contract version enforced on both launch and callback exchanges. Optional,
# defaults to 1.0.
N8N_CONTRACT_VERSION=1.0

# Max wait (ms) for the immediate 202 Accepted response from n8n. Optional,
# defaults to 10000.
N8N_LAUNCH_TIMEOUT_MS=10000

# Max accepted CDC PDF size in bytes. Optional, defaults to 52428800 (50 MB).
MAX_CDC_UPLOAD_BYTES=52428800

# Local CDC parser selection. Marker remains the safe default/rollback path.
# n8n continues to consume the historical MARKER_* URL contract; the startup
# scripts map those URLs to this Docling-compatible adapter when selected.
DOCUMENT_PARSER=marker
DOCLING_SERVICE_URL=http://127.0.0.1:8010
DOCLING_PYTHON=/home/USER/.venv-docling/bin/python
DOCLING_DATA_ROOT=/home/USER/.n8n-files
DOCLING_ACCELERATOR_DEVICE=auto

# Max minutes a processing job may sit in created/queued/running/retrying before
# it's treated as stale (e.g. its callback never arrived - wrong
# PLATFORM_PUBLIC_BASE_URL, downed pipeline service). Checked lazily on the main
# read paths, not by a background worker; see lib/appels-offres/repository.ts
# (reapStaleProcessingJobs). Optional, defaults to 15.
PROCESSING_JOB_TIMEOUT_MINUTES=15

# Legacy compatibility route only (POST /api/fiche/[code]/complete). No longer
# part of the canonical contract - the active n8n workflow calls the canonical
# callback route above instead. Keep only if something still posts to the old
# route; otherwise safe to leave unset.
N8N_COMPLETE_SECRET=replace-with-legacy-complete-secret

# NOT read by this Next.js app. This is the n8n RUNTIME's own environment
# variable (used by the Gemini HTTP request node inside the workflow - see
# scripts/n8n-tests/start_n8n_canonical_test.cmd). Documented here only so
# the full set of variables both sides need is in one place.
GEMINI_API_KEY=replace-with-gemini-api-key

# Global CDC confidentiality invariant and provider policy.
# Local is the code default. Gemini requires all three explicit controls below:
# confidential mode false, comparison enabled, and an allowlisted code_interne.
CONFIDENTIAL_MODE=true
CDC_AI_PROVIDER=local
LOCAL_FICHE_MODEL=qwen3:14b
EXTERNAL_AI_COMPARISON_ENABLED=false
EXTERNAL_AI_AUTHORIZED_CDC_IDS=

# Legacy flag retained only for deployment compatibility; automatic shadow is disabled.
LOCAL_RAG_SHADOW_ENABLED=false
LOCAL_RAG_SERVICE_URL=http://127.0.0.1:8091
LOCAL_RAG_SERVICE_TOKEN=replace-with-local-only-token
LOCAL_RAG_CONTRACT_VERSION=local-cdc-shadow.v1
LOCAL_RAG_SHADOW_TIMEOUT_MS=120000

# Dedicated FCI launch webhook called by
# POST /api/appels-offres/[code]/fci/[module]/generate and /regenerate.
# Must point to the separate FCI n8n workflow, not to the CDC workflow.
FCI_N8N_WEBHOOK_URL=https://n8n.example.com/webhook/fci-module-generation

# Bearer token Concept sends when launching an FCI generation request to n8n.
FCI_N8N_WEBHOOK_TOKEN=replace-with-fci-launch-token

# Bearer token n8n must send back on POST /api/fci/callbacks/n8n.
FCI_CALLBACK_BEARER_TOKEN=replace-with-fci-callback-bearer-token

# Shared HMAC secret used to verify X-Callback-Signature on the FCI callback route.
FCI_CALLBACK_HMAC_SECRET=replace-with-fci-hmac-secret

# Max accepted callback age in seconds for the signed FCI callback route.
# Optional, defaults to 300.
FCI_CALLBACK_MAX_AGE_SECONDS=300

# FCI launch/callback contract version. Optional, defaults to 1.0.
FCI_N8N_CONTRACT_VERSION=1.0

# Max wait (ms) for the immediate 202 Accepted response from the FCI webhook.
# Optional, defaults to 10000.
FCI_N8N_LAUNCH_TIMEOUT_MS=10000

# Provider/model metadata recorded on FCI generation jobs and sent to n8n.
FCI_GENERATION_PROVIDER=gemini
FCI_GENERATION_MODEL=gemini-3.6-flash

# n8n runtime only: URL of the local/remote callback signer used by the FCI
# workflow to compute X-Callback-Signature over the raw callback body.
# The signer process must use the same FCI_CALLBACK_HMAC_SECRET value as Concept.
FCI_CALLBACK_SIGNER_URL=http://127.0.0.1:8899/sign

# Public URL of the local Open WebUI instance linked from the "Assistant IA"
# sidebar item (opens in a new tab). NEXT_PUBLIC_ prefix required so the
# browser can read it. Local-first: no chat model or provider is configured
# here - CONCEPT only links to the existing local assistant, it never calls it.
# Optional: if unset, "Assistant IA" renders disabled instead of breaking the sidebar.
NEXT_PUBLIC_OPEN_WEBUI_URL=http://localhost:3002
