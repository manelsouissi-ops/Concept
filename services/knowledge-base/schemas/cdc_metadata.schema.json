{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CONCEPT Historical CDC Metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["document_id", "document_version_id", "source_filename", "source_path", "source_hash", "language"],
  "properties": {
    "document_id": {"type": "string", "minLength": 1},
    "document_version_id": {"type": "string", "minLength": 1},
    "source_filename": {"type": "string", "minLength": 1},
    "source_path": {"type": ["string", "null"]},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "internal_code": {"type": ["string", "null"]},
    "project_title": {"type": ["string", "null"]},
    "country": {"type": ["string", "null"]},
    "countries": {"type": "array", "items": {"type": "string"}},
    "language": {"type": "string", "enum": ["fr", "en", "ar", "mixed", "unknown"]},
    "mission_type": {"type": ["string", "null"]},
    "project_type": {"type": ["string", "null"]},
    "sector": {"type": ["string", "null"]},
    "subsector": {"type": ["string", "null"]},
    "client": {"type": ["string", "null"]},
    "contracting_authority": {"type": ["string", "null"]},
    "funding_institution": {"type": ["string", "null"]},
    "selection_method": {"type": ["string", "null"]},
    "publication_date": {"type": ["string", "null"]},
    "submission_deadline": {"type": ["string", "null"]},
    "project_duration": {"type": ["string", "null"]},
    "main_scope": {"type": ["string", "null"]},
    "main_components": {"type": "array", "items": {"type": "string"}},
    "services": {"type": "array", "items": {"type": "string"}},
    "technical_requirements": {"type": "array", "items": {"type": "string"}},
    "required_expertise": {"type": "array", "items": {"type": "string"}},
    "key_personnel": {"type": "array", "items": {"type": "string"}},
    "financial_conditions": {"type": ["string", "null"]},
    "guarantees": {"type": "array", "items": {"type": "string"}},
    "insurance_requirements": {"type": "array", "items": {"type": "string"}},
    "contractual_conditions": {"type": ["string", "null"]},
    "keywords": {"type": "array", "items": {"type": "string"}},
    "extraction_confidence": {"type": ["string", "null"], "enum": ["high", "medium", "low", null]}
  }
}
