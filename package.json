{
  "name": "initiation-cdc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_DIST_DIR=.next-dev next dev",
    "build:prod": "cross-env NEXT_DIST_DIR=.next-prod next build",
    "start:prod": "cross-env NEXT_DIST_DIR=.next-prod next start -p 3016",
    "typecheck": "tsc --noEmit",
    "n8n:status": "scripts/manage-n8n.sh status",
    "n8n:check": "scripts/manage-n8n.sh check",
    "n8n:restart": "scripts/manage-n8n.sh restart",
    "concept:start": "scripts/start-concept.sh",
    "concept:status": "scripts/manage-concept.sh status --full",
    "concept:check": "scripts/manage-concept.sh check --full",
    "concept:restart": "scripts/manage-concept.sh restart --full",
    "test:gemini": "node scripts/test-gemini.mjs",
    "test:fci-contracts": "node --experimental-strip-types scripts/test-fci-ai-contracts.ts",
    "db:setup": "node --experimental-strip-types scripts/setup-fiche-index.ts",
    "db:backfill": "node --experimental-strip-types scripts/backfill-fiches-to-postgres.ts",
    "db:reconcile:appels-offres": "node --experimental-strip-types scripts/reconcile-appels-offres-to-postgres.ts",
    "verify:platform-n8n-contract": "node --experimental-strip-types scripts/verify-platform-n8n-contract.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "bcryptjs": "^3.0.3",
    "fast-xml-parser": "^4.5.1",
    "next": "^15.0.0",
    "pdfjs-dist": "^6.1.200",
    "pg": "^8.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "cross-env": "^10.1.0",
    "dotenv": "^16.6.1",
    "typescript": "^5.7.2"
  }
}
