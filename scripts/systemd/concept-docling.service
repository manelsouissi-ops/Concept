[Unit]
Description=CONCEPT Docling parser adapter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStart=@REPO_ROOT@/scripts/start-docling-local.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
