[Unit]
Description=CONCEPT historical knowledge base
After=network-online.target postgresql.service concept-docling.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@REPO_ROOT@
ExecStart=@REPO_ROOT@/scripts/start-kb-local.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

[Install]
WantedBy=default.target
