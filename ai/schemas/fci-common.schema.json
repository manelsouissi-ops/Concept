{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://concept.local/ai/schemas/fci-common.schema.json",
  "title": "CONCEPT FCI AI Common Contract",
  "$defs": {
    "source_type": {
      "type": "string",
      "enum": [
        "fiche_cdc",
        "ai_inference",
        "internal_required",
        "unavailable",
        "not_applicable"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low",
        "none"
      ]
    },
    "source_reference": {
      "type": "object",
      "properties": {
        "section": {
          "type": "string",
          "minLength": 1
        },
        "field": {
          "type": "string",
          "minLength": 1
        },
        "excerpt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "section",
        "field",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "source_references": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_reference"
      }
    },
    "field_base": {
      "type": "object",
      "properties": {
        "value": {},
        "source_type": {
          "$ref": "#/$defs/source_type"
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        },
        "requires_human_input": {
          "type": "boolean"
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "source_references": {
          "$ref": "#/$defs/source_references"
        }
      },
      "required": [
        "value",
        "source_type",
        "confidence",
        "requires_human_input",
        "justification",
        "source_references"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "source_type": {
                "const": "internal_required"
              }
            },
            "required": [
              "source_type"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "const": null
              },
              "requires_human_input": {
                "const": true
              },
              "confidence": {
                "const": "none"
              }
            }
          }
        }
      ]
    },
    "field_nullable_string": {
      "allOf": [
        {
          "$ref": "#/$defs/field_base"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "field_nullable_string_array": {
      "allOf": [
        {
          "$ref": "#/$defs/field_base"
        },
        {
          "properties": {
            "value": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        }
      ]
    },
    "field_nullable_boolean": {
      "allOf": [
        {
          "$ref": "#/$defs/field_base"
        },
        {
          "properties": {
            "value": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        }
      ]
    },
    "field_nullable_number_or_string": {
      "allOf": [
        {
          "$ref": "#/$defs/field_base"
        },
        {
          "properties": {
            "value": {
              "type": [
                "number",
                "string",
                "null"
              ]
            }
          }
        }
      ]
    },
    "field_preliminary_review_status": {
      "allOf": [
        {
          "$ref": "#/$defs/field_base"
        },
        {
          "properties": {
            "value": {
              "type": [
                "string",
                "null"
              ],
              "enum": [
                "favorable_for_review",
                "conditional_review",
                "insufficient_information",
                "high_risk_review",
                null
              ]
            }
          }
        }
      ]
    },
    "summary": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "complete",
            "partial",
            "insufficient_data"
          ]
        },
        "completion_percentage": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "human_inputs_required": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "completion_percentage",
        "human_inputs_required",
        "warnings"
      ],
      "additionalProperties": false
    },
    "source_fiche": {
      "type": "object",
      "properties": {
        "code_interne": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "hash": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "processing",
            "draft",
            "validated",
            "error"
          ]
        },
        "validated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      },
      "required": [
        "code_interne",
        "version",
        "hash",
        "status",
        "validated_at"
      ],
      "additionalProperties": false
    },
    "module_envelope_base": {
      "type": "object",
      "properties": {
        "contract_version": {
          "const": "1.0"
        },
        "module_code": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "module_type": {
          "type": "string",
          "enum": [
            "commercial",
            "finance",
            "operations",
            "strategy"
          ]
        },
        "generated_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "source_fiche": {
          "$ref": "#/$defs/source_fiche"
        },
        "summary": {
          "$ref": "#/$defs/summary"
        },
        "data": {
          "type": "object"
        },
        "ai_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "contract_version",
        "module_code",
        "module_type",
        "generated_at",
        "source_fiche",
        "summary",
        "data",
        "ai_notes",
        "validation_warnings"
      ],
      "additionalProperties": false
    },
    "finance_calculation_input": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": [
            "number",
            "string",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_references": {
          "$ref": "#/$defs/source_references"
        }
      },
      "required": [
        "label",
        "value",
        "unit",
        "source_references"
      ],
      "additionalProperties": false
    },
    "finance_calculation": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finance_calculation_input"
          }
        },
        "result": {
          "$ref": "#/$defs/field_nullable_number_or_string"
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "source_references": {
          "$ref": "#/$defs/source_references"
        }
      },
      "required": [
        "label",
        "formula",
        "inputs",
        "result",
        "justification",
        "source_references"
      ],
      "additionalProperties": false
    }
  }
}
