      "id": "kb-batch-child", "name": "Run Single CDC", "type": "n8n-nodes-base.executeWorkflow", "typeVersion": 1.1, "position": [1280, 190], "continueOnFail": true
    },
    {
      "parameters": {"jsCode": "const sd=$getWorkflowStaticData('global'); sd.kb=sd.kb||{processed:0,skipped:0,updated:0,failed:0};\nconst j=$input.first().json||{}; const outcome=j.batch_outcome||'FAILED';\nif(outcome==='PROCESSED')sd.kb.processed++; else if(outcome==='SKIPPED')sd.kb.skipped++; else if(outcome==='UPDATED')sd.kb.updated++; else sd.kb.failed++;\nreturn [{json:j}];"},
      "id": "kb-batch-tally", "name": "Tally Without Stopping", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1510, 190]
    },
    {
      "parameters": {"jsCode": "const k=$getWorkflowStaticData('global').kb||{processed:0,skipped:0,updated:0,failed:0}; return [{json:{TOTAL:k.processed+k.skipped+k.updated+k.failed,PROCESSED:k.processed,SKIPPED:k.skipped,UPDATED:k.updated,FAILED:k.failed}}];"},
      "id": "kb-batch-summary", "name": "Final Summary", "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1280, 430]
    },
