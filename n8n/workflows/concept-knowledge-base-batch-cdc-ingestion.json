      "id": "kb-batch-discover", "name": "Discover PDFs Safely", "type": "n8n-nodes-base.executeCommand", "typeVersion": 1, "position": [610, 300]
    },
    {
      "parameters": {"jsCode": "const output=String($input.first().json.stdout||'');\nreturn output.split('\\n').filter(Boolean).map(line=>({json:JSON.parse(line)}));"},
