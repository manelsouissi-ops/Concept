# Copy to .env.local and replace every CHANGE_ME value. Never commit .env.local.
DATABASE_URL=postgresql://concept_user:CHANGE_ME@127.0.0.1:5432/GONOGO
AUTH_SECRET=CHANGE_ME_RANDOM_32_BYTES_OR_MORE
AUTH_SESSION_TTL_SECONDS=43200
CONCEPT_DEV_ADMIN_PASSWORD=CHANGE_ME
CONCEPT_DEV_USER_PASSWORD=CHANGE_ME
CONCEPT_ENABLE_DEV_USER_SWITCHER=false

# Next.js and canonical CDC pipeline (actual local ports: 3000 and 5678).
CONCEPT_APP_PORT=3000
PLATFORM_PUBLIC_BASE_URL=http://127.0.0.1:3000
N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/cdc-initiation-fiche-projet-xml
N8N_WEBHOOK_TOKEN=CHANGE_ME
PLATFORM_CALLBACK_TOKEN=CHANGE_ME
N8N_CALLBACK_SECRET=CHANGE_ME
N8N_CONTRACT_VERSION=1.0
N8N_LAUNCH_TIMEOUT_MS=10000
MAX_CDC_UPLOAD_BYTES=52428800
PROCESSING_JOB_TIMEOUT_MINUTES=15
N8N_COMPLETE_SECRET=

# FCI pipeline.
FCI_N8N_WEBHOOK_URL=http://127.0.0.1:5678/webhook/fci-module-generation
FCI_N8N_WEBHOOK_TOKEN=CHANGE_ME
FCI_CALLBACK_BEARER_TOKEN=CHANGE_ME
FCI_CALLBACK_HMAC_SECRET=CHANGE_ME
FCI_CALLBACK_MAX_AGE_SECONDS=300
FCI_N8N_CONTRACT_VERSION=1.0
FCI_N8N_LAUNCH_TIMEOUT_MS=10000
FCI_GENERATION_PROVIDER=gemini
FCI_GENERATION_MODEL=gemini-3.6-flash

# Variables consumed by n8n/Marker/signer, loaded by start-concept.sh.
GEMINI_API_KEY=CHANGE_ME
DOCUMENT_PARSER=marker
MARKER_SERVICE_DIR=/home/USER/FastMarker-API
MARKER_DATA_ROOT=/home/USER/.n8n-files
MARKER_CONVERT_URL=http://127.0.0.1:8000/convert
MARKER_STATUS_URL=http://127.0.0.1:8000/status
MARKER_RESULT_URL=http://127.0.0.1:8000/result
DOCLING_SERVICE_URL=http://127.0.0.1:8010
DOCLING_PYTHON=/home/USER/.venv-docling/bin/python
DOCLING_DATA_ROOT=/home/USER/.n8n-files
DOCLING_ACCELERATOR_DEVICE=auto
N8N_CALLBACK_SIGNER_URL=http://127.0.0.1:8899/sign
FCI_CALLBACK_SIGNER_URL=http://127.0.0.1:8899/sign
N8N_SHARED_STORAGE_ROOT=/home/USER/Concept/data
N8N_RESTRICT_FILE_ACCESS_TO=/home/USER/Concept/data
N8N_BLOCK_ENV_ACCESS_IN_NODE=false

# Controlled CDC extraction provider. Gemini remains the safe default.
# local is recognized but fails closed until the full canonical Fiche XML contract is covered.
CDC_AI_PROVIDER=gemini
LOCAL_RAG_SERVICE_URL=http://127.0.0.1:8091
LOCAL_RAG_SERVICE_TOKEN=CHANGE_ME
LOCAL_RAG_CONTRACT_VERSION=local-cdc-shadow.v1
LOCAL_RAG_SHADOW_LOG_DIR=/tmp/concept-local-rag-shadow
LOCAL_RAG_SHADOW_ENABLED=false
LOCAL_RAG_SHADOW_TIMEOUT_MS=120000

# Optional feature switch read by the application.
KNOWLEDGE_BASE_ENABLED=false
